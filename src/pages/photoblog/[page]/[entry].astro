---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NavbarItem from "../../../components/NavbarItem.astro";
import LinkButton from "../../../components/LinkButton.astro";

import {
  getBlogPages,
  getBlogEntriesForPage,
  getBlogEntriesForSection,
  getBlogSectionsForPage,
  selectPics,
  getAlbumsByTag,
} from "../../../scripts/digikam_connector.ts";

import { getBlogPageIcon, toURL } from "../../../scripts/util.ts";

export async function getStaticPaths() {
  const blogRootAlbums = await getAlbumsByTag("Blog");
  const pages = blogRootAlbums.map(album => album.relativePath);
  let paths = [];
  for (const page of pages) {
    const entries = await getBlogEntriesForPage(page);
    paths.push(
      ...entries.map((entry, index) => {
        const prev = index > 0 ? entries[index - 1] : null;
        const next = index < entries.length - 1 ? entries[index + 1] : null;
        return {
          params: { page: toURL(page), entry: entry.name.toLowerCase() },
          props: { pageRelativePath: page, pageURL: toURL(page), entry: entry, prev: prev, next: next },
        };
      }),
    );
  }
  return paths;
}

const { pageRelativePath, pageURL, entry, prev, next } = Astro.props;

const blogPages = (await getBlogPages()).reverse();

const pics = await selectPics([entry.id], 2);

const s = await getBlogSectionsForPage(pageRelativePath);
let sections: any[] = [];
for (const section of s) {
  const entries = await getBlogEntriesForSection(pageRelativePath, section.name);
  sections.push({
    ...section,
    entries: entries
  });
}
console.log(entry.relativePath);
---
<style>
h2 {
    font-family: 'DotMatrix';
}
.scroll-container {
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  height: 600px;
  scroll-snap-type: y mandatory;
}
.img-container {
  width: 100%;
  height: 600px;
  position: relative;
}
.img-container img {
  display: flex;
  max-height: 100%;
  max-width: 100%;
  /* width: auto; */
  margin-left: auto; 
  margin-right: auto;
  border-radius: 1.5em;
  scroll-snap-align: start;
}
.text-caption {
  background: rgba(0.4, 0.4, 0.4, 0.7);
  padding: 1em;
  color: white;
  position: absolute;
  bottom: 2em;
  width: fit-content;
  max-width: 80%;
  left: 0;
  right: 0;
  margin-inline: auto;
  border-radius: 0.5em;
}
.text-caption p {
  margin: 0;
}
#prevEntryButton {
  margin-right: 1em;
}
</style>

<!-- fuckass way to make the browser start at the bottom of the page -->
<script>window.onload=() => window.scrollTo(0, document.body.scrollHeight)</script>

<BaseLayout title="Photoblog" icon={getBlogPageIcon(pageURL)} >
  <span slot="navbarContent">
  {
    blogPages.map(page => page.relativePath == pageRelativePath ?
      <NavbarItem icon={page.icon} name={page.shortName} isCurrentPage={true}
                  link={`/photoblog/${page.urlPart}`} level={2} >
      {
        sections.map(section => {
          const isCurrentSection = section.entries.some((e: any) => e.relativePath == entry.relativePath);
          return <NavbarItem name={section.name} level={3} isCurrentPage={isCurrentSection}
                  link={`/photoblog/${page.urlPart}/${section.entries[0].name.toLowerCase()}`}/>
        })
      }
      </NavbarItem> :
      <NavbarItem icon={page.icon} name={page.shortName} isCurrentPage={false}
                  link={`/photoblog/${page.urlPart}`} level={2} />
    )
  }
  </span>
  <h2>{entry.section}</h2>
  <h3>{new Date(entry.date!).toLocaleDateString()}
    {entry.caption && ` - ${entry.caption}`}
  </h3>
  <p style="display: flex; align-items: center; justify-content: space-between;">
    <LinkButton
      href={`/photoblog/${pageURL}`}
      accentColor={3}
    >
      &lt;-- zurück
    </LinkButton>
    <span>
      { prev && 
        <span id="prevEntryButton">
          <LinkButton
            href=`/photoblog/${pageURL}/${prev.name.toLowerCase()}`
            accentColor={3}
          >
            &lt;- vorheriger Eintrag
          </LinkButton>
        </span>
      }
      { next && 
        <LinkButton
          href=`/photoblog/${pageURL}/${next.name.toLowerCase()}`
          accentColor={3}
        >
          nächster Eintrag -&gt;
        </LinkButton>
      }
    </span>
  </p>
  <div class="scroll-container">
    { pics.map((pic) => 
      <div class="img-container">
        <img src={pic.path} title={pic.title}) />
        {pic.caption && <div class="text-caption"><p>{pic.caption}</p></div>}
      </div>)
    }
  </div>
</BaseLayout>
