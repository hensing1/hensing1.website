---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavbarItem from "../../components/NavbarItem.astro";
import SectionComponent from "../../components/BlogPageSection.astro";

import {
  getBlogPages,
  getAlbumsByTag,
  getBlogSectionsForPage,
} from "../../scripts/digikam_connector.ts";
import { getBlogPageIcon } from "../../scripts/util.ts";

import {
  toURL
} from "../../scripts/util.ts";

// Make a page for every album in digikam with category "Blog"
export async function getStaticPaths() {
  const blogAlbums = await getAlbumsByTag("Blog");

  return blogAlbums.map((album) => {
    return {
      params: { page: toURL(album.relativePath) },
      props: { title: album.relativePath.slice(1).replaceAll("/", " | "), album: album },
    };
  });
}
const blogPages = (await getBlogPages()).reverse();

const { title: pageTitle, album: album } = Astro.props;

const icon = getBlogPageIcon(toURL(album.relativePath));

const sections = await getBlogSectionsForPage(album.relativePath);
---

<style>
  h1 {
    border-bottom: 2px solid black;
    /* font-family: 'DotMatrix'; */
  }
  #back {
    float: right;
  }
</style>

<BaseLayout icon={icon} title="Photoblog">
  <span slot="navbarContent">
  {
    blogPages.map(page => page.relativePath == album.relativePath ?
      <NavbarItem icon={page.icon} name={page.shortName} isCurrentPage={true}
                  link={`/photoblog/${page.urlPart}`} level={2} >
      {
        sections.map(section => <NavbarItem name={section.name} level={3}/>)
      }
      </NavbarItem> :
      <NavbarItem icon={page.icon} name={page.shortName} isCurrentPage={false}
                  link={`/photoblog/${page.urlPart}`} level={2} />
    )
  }
  </span>
  <h1>{pageTitle}</h1>
  <a href="/photoblog" id="back" class="redlink">&lt;- zurück</a>
  {
    sections.map((section) => <>
      <SectionComponent page={album.relativePath} pageURL={toURL(album.relativePath)} section={section.name} />
    </>)
  }
</BaseLayout>
