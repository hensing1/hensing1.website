---
import BaseLayout from "../layouts/BaseLayout.astro";
import Masonry from "../components/ImageMasonry.astro";

import { getBlogPageNames, getAlbumIDsByPath, getAlbumsByTag, selectPics } from "../scripts/digikam_connector.ts";
import { alias } from "astro:db";

export const icon = "📸";
export const title = "Photoblog";
export const index = 1;

const albums = await getAlbumsByTag("Blog");

const pathParts = albums.map((album) => album.relativePath.split("/", 3).splice(1));
const paths = new Map();
pathParts.forEach((part: Array<string>) => {
    const [year, name] = part;
    if (!paths.has(year)) {
        paths.set(year, []);
    }
    paths.get(year).push(name);
});

// const featuredImages = await selectPics(albumIDs, 4);
---

<style>
    h1 {
        border-bottom: 2px solid black;
    }

    .single-file {
        display: none;
    }

    @media screen and (max-width: 636px) {
        .single-file {
            display: unset;
        }

        .double-file {
            display: none;
        }
    }
</style>

<BaseLayout icon={icon} title={title}>
    <h1>Pinterest des Grauens</h1>

    {
        Array.from(paths.keys()).sort().reverse().map((year) => <>
            <h2>{year}</h2>
            {
                paths.get(year).sort().reverse().map((entry: string) => <h3>{entry}</h3>)
            }
        </>)
    }

